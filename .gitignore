# Reference mirror of the live WordPress site — build-time reference only,
# never deployed. Regenerate with: python _tools/mirror.py
_source/

# Scratch files
_tools/ps_old.html

# Form backend — real config and received submissions never leave the server
api/config.php
_submissions/

# Server-side received submissions (bind mount from docker-compose)
submissions/

# Real SMTP credentials for the interim server
msmtprc

# Client quote/proposal documents - private, never published
_proposal/
__pycache__/

# Written by _deploy/auto-deploy.sh in the server's staging clone: what it
# last deployed. Ignored so that clone's working tree stays clean (cPanel's
# own deployment wants a clean tree); the deploy still copies it to staging.
/version.txt
